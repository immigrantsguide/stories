<meta name="theme-color" content="#090b10">
<title>NISHAACHARUDU — Episode 1: The Silent Well</title>
<style>
  :root {
    color-scheme: dark;
    --bg: #090b10;
    --panel: #11151d;
    --text: #e9e7e2;
    --muted: #a6a7ad;
    --accent: #b51f2b;
    --line: #292d36;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(116, 20, 30, .18), transparent 42rem),
      var(--bg);
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.85;
  }
  .reading-track {
    position: fixed;
    inset: 0 0 auto;
    height: 4px;
    background: rgba(255,255,255,.10);
    z-index: 20;
  }
  .reading-progress {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #6f101b, #e0444f);
    box-shadow: 0 0 12px rgba(224,68,79,.65);
  }
  .reading-label {
    position: fixed;
    top: 12px;
    right: 16px;
    z-index: 15;
    color: #c9c4bf;
    background: rgba(9,11,16,.78);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    padding: 5px 10px;
    font: 12px/1.2 Arial, sans-serif;
    backdrop-filter: blur(8px);
  }
  header {
    min-height: 360px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 90px 22px 55px;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(rgba(5,7,11,.45), rgba(5,7,11,.92)),
      radial-gradient(ellipse at 50% 40%, rgba(140,25,35,.30), transparent 55%);
  }
  .eyebrow {
    color: #d34b55;
    letter-spacing: .32em;
    text-transform: uppercase;
    font: 700 11px/1.5 Arial, sans-serif;
  }
  h1 {
    margin: 14px 0 2px;
    color: #f1e9df;
    font: 900 clamp(2.6rem, 9vw, 5.7rem)/1.02 Georgia, serif;
    letter-spacing: .045em;
    text-shadow: 0 5px 30px rgba(180,25,40,.35);
  }
  .subtitle {
    margin: 15px 0 0;
    color: #c8c0b9;
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-style: italic;
  }
  .episode {
    margin-top: 28px;
    color: #e6d8d0;
    font: 700 12px/1.5 Arial, sans-serif;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  main {
    width: min(760px, calc(100% - 40px));
    margin: 0 auto;
    padding: 54px 0 70px;
  }
  .story p {
    margin: 0 0 1.25em;
    font-size: clamp(1.05rem, 2.4vw, 1.18rem);
  }
  .story .time {
    margin: 2.2em 0 1em;
    color: #d45a63;
    font: 700 .76rem/1.5 Arial, sans-serif;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .story .sound {
    color: #f0c7c8;
    font-weight: bold;
    letter-spacing: .04em;
  }
  .story .shout {
    color: #f1d8d4;
    font-weight: bold;
    letter-spacing: .025em;
  }
  .divider {
    width: 58px;
    height: 2px;
    margin: 2.6em auto;
    background: var(--accent);
    opacity: .8;
  }
  .ending {
    margin: 3em 0 1em;
    padding: 25px 18px;
    border: 1px solid #55232a;
    background: linear-gradient(135deg, rgba(104,16,27,.22), rgba(17,21,29,.75));
    text-align: center;
  }
  .ending strong {
    display: block;
    color: #f2e7df;
    font-size: 1.35rem;
    letter-spacing: .12em;
  }
  .ending span {
    display: block;
    margin-top: 8px;
    color: #c9a6a5;
    font: 700 .72rem/1.5 Arial, sans-serif;
    letter-spacing: .22em;
  }
  footer {
    border-top: 1px solid var(--line);
    padding: 24px 18px 36px;
    text-align: center;
    color: var(--muted);
    font: 13px/1.6 Arial, sans-serif;
  }
  footer strong { color: #e14a55; }
  @media (max-width: 520px) {
    header { min-height: 310px; }
    main { width: min(100% - 34px, 760px); padding-top: 38px; }
    .reading-label { top: 10px; right: 10px; }
  }
</style>
